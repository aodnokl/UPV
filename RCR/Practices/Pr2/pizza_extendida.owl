<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.upv.es/etsinf/rcr/pizza.owl"
         xmlns="http://www.upv.es/etsinf/rcr/pizza.owl#">

<owl:Ontology rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl"/>

<owl:ObjectProperty rdf:about="#hasBase">
  <rdfs:subPropertyOf rdf:resource="#hasIngredient"/>
  <owl:inverseOf rdf:resource="#isBaseOf"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Pizza"/>
  <rdfs:range rdf:resource="#PizzaBase"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasIngredient">
  <owl:inverseOf rdf:resource="#isIngredientOf"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Pizza"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isBaseOf">
  <rdfs:subPropertyOf rdf:resource="#isIngredientOf"/>
  <rdfs:domain rdf:resource="#PizzaBase"/>
  <rdfs:range rdf:resource="#Pizza"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCountryOfOrigin">
  <owl:inverseOf rdf:resource="#isOriginOf"/>
  <rdfs:domain rdf:resource="#Pizza"/>
  <rdfs:range rdf:resource="#Country"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isOriginOf">
  <rdfs:domain rdf:resource="#Country"/>
  <rdfs:range rdf:resource="#Pizza"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isIngredientOf">
  <rdfs:range rdf:resource="#Pizza"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasTopping">
  <rdfs:subPropertyOf rdf:resource="#hasIngredient"/>
  <owl:inverseOf rdf:resource="#isToppingOf"/>
  <rdfs:domain rdf:resource="#Pizza"/>
  <rdfs:range rdf:resource="#PizzaTopping"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isToppingOf">
  <rdfs:subPropertyOf rdf:resource="#isIngredientOf"/>
  <rdfs:domain rdf:resource="#PizzaTopping"/>
  <rdfs:range rdf:resource="#Pizza"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#realizaPedido">
  <rdfs:domain rdf:resource="#Cliente"/>
  <rdfs:range rdf:resource="#Pedido"/>
  <owl:inverseOf rdf:resource="#esRealizadoPor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#esRealizadoPor">
  <rdfs:domain rdf:resource="#Pedido"/>
  <rdfs:range rdf:resource="#Cliente"/>
  <owl:inverseOf rdf:resource="#realizaPedido"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contienePizza">
  <rdfs:domain rdf:resource="#Pedido"/>
  <rdfs:range rdf:resource="#Pizza"/>
  <owl:inverseOf rdf:resource="#esPizzaDe"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#esPizzaDe">
  <rdfs:domain rdf:resource="#Pizza"/>
  <rdfs:range rdf:resource="#Pedido"/>
  <owl:inverseOf rdf:resource="#contienePizza"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#Pizza">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasBase"/>
      <owl:someValuesFrom rdf:resource="#PizzaBase"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#PizzaBase">
  <owl:disjointWith rdf:resource="#PizzaTopping"/>
</owl:Class>

<owl:Class rdf:about="#Country"/>

<owl:Class rdf:about="#PizzaTopping"/>

<owl:Class rdf:about="#AmericanHotPizza">
  <rdfs:subClassOf rdf:resource="#NamedPizza"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:someValuesFrom rdf:resource="#JalapenoPepperTopping"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:someValuesFrom rdf:resource="#MozzarellaTopping"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:someValuesFrom rdf:resource="#PepperoniTopping"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:someValuesFrom rdf:resource="#TomatoTopping"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pizza that only has Mozarrella and Tomato toppings</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NamedPizza">
  <rdfs:subClassOf rdf:resource="#Pizza"/>
</owl:Class>

<owl:Class rdf:about="#JalapenoPepperTopping">
  <rdfs:subClassOf rdf:resource="#PepperTopping"/>
</owl:Class>

<owl:Class rdf:about="#MozzarellaTopping">
  <rdfs:subClassOf rdf:resource="#CheeseTopping"/>
  <owl:disjointWith rdf:resource="#ParmesanTopping"/>
</owl:Class>

<owl:Class rdf:about="#PepperoniTopping">
  <rdfs:subClassOf rdf:resource="#MeatTopping"/>
</owl:Class>

<owl:Class rdf:about="#TomatoTopping">
  <rdfs:subClassOf rdf:resource="#VegetableTopping"/>
</owl:Class>

<owl:Class rdf:about="#AmericanPizza">
  <rdfs:subClassOf rdf:resource="#NamedPizza"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:someValuesFrom rdf:resource="#MozzarellaTopping"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:someValuesFrom rdf:resource="#PepperoniTopping"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:someValuesFrom rdf:resource="#TomatoTopping"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pizza that only has Mozarrella and Tomato toppings</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AnchovyTopping">
  <rdfs:subClassOf rdf:resource="#SeafoodTopping"/>
</owl:Class>

<owl:Class rdf:about="#SeafoodTopping">
  <rdfs:subClassOf rdf:resource="#PizzaTopping"/>
</owl:Class>

<owl:Class rdf:about="#CaperTopping">
  <rdfs:subClassOf rdf:resource="#VegetableTopping"/>
</owl:Class>

<owl:Class rdf:about="#VegetableTopping">
  <rdfs:subClassOf rdf:resource="#PizzaTopping"/>
</owl:Class>

<owl:Class rdf:about="#CheeseTopping">
  <rdfs:subClassOf rdf:resource="#PizzaTopping"/>
</owl:Class>

<owl:Class rdf:about="#CheesyPizza">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Pizza"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasTopping"/>
          <owl:someValuesFrom rdf:resource="#CheeseTopping"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#DeepPanBase">
  <rdfs:subClassOf rdf:resource="#PizzaBase"/>
  <owl:disjointWith rdf:resource="#ThinAndCrispyBase"/>
</owl:Class>

<owl:Class rdf:about="#ThinAndCrispyBase">
  <rdfs:subClassOf rdf:resource="#PizzaBase"/>
</owl:Class>

<owl:Class rdf:about="#GreenPepperTopping">
  <rdfs:subClassOf rdf:resource="#PepperTopping"/>
</owl:Class>

<owl:Class rdf:about="#PepperTopping">
  <rdfs:subClassOf rdf:resource="#VegetableTopping"/>
</owl:Class>

<owl:Class rdf:about="#HamTopping">
  <rdfs:subClassOf rdf:resource="#MeatTopping"/>
</owl:Class>

<owl:Class rdf:about="#MeatTopping">
  <rdfs:subClassOf rdf:resource="#PizzaTopping"/>
</owl:Class>

<owl:Class rdf:about="#MargheritaPizza">
  <rdfs:subClassOf rdf:resource="#NamedPizza"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:someValuesFrom rdf:resource="#MozzarellaTopping"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:someValuesFrom rdf:resource="#TomatoTopping"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pizza that only has Mozarrella and Tomato toppings</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ParmesanTopping">
  <rdfs:subClassOf rdf:resource="#CheeseTopping"/>
</owl:Class>

<owl:Class rdf:about="#MushroomTopping">
  <rdfs:subClassOf rdf:resource="#VegetableTopping"/>
</owl:Class>

<owl:Class rdf:about="#OliveTopping">
  <rdfs:subClassOf rdf:resource="#VegetableTopping"/>
</owl:Class>

<owl:Class rdf:about="#OnionTopping">
  <rdfs:subClassOf rdf:resource="#VegetableTopping"/>
</owl:Class>

<owl:Class rdf:about="#PrawnTopping">
  <rdfs:subClassOf rdf:resource="#SeafoodTopping"/>
</owl:Class>

<owl:Class rdf:about="#RedPepperTopping">
  <rdfs:subClassOf rdf:resource="#PepperTopping"/>
</owl:Class>

<owl:Class rdf:about="#SalamiTopping">
  <rdfs:subClassOf rdf:resource="#MeatTopping"/>
</owl:Class>

<owl:Class rdf:about="#SohoPizza">
  <rdfs:subClassOf rdf:resource="#NamedPizza"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:someValuesFrom rdf:resource="#MozzarellaTopping"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:someValuesFrom rdf:resource="#OliveTopping"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:someValuesFrom rdf:resource="#ParmesanTopping"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:someValuesFrom rdf:resource="#TomatoTopping"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pizza that only has Mozarrella and Tomato toppings</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SpicyBeefTopping">
  <rdfs:subClassOf rdf:resource="#MeatTopping"/>
</owl:Class>

<owl:Class rdf:about="#TunaTopping">
  <rdfs:subClassOf rdf:resource="#SeafoodTopping"/>
</owl:Class>

<owl:Class rdf:about="#VegetarianPizza">
  <rdfs:subClassOf rdf:resource="#Pizza"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasTopping"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#CheeseTopping"/>
            <rdf:Description rdf:about="#VegetableTopping"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Persona">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Cliente">
  <rdfs:subClassOf rdf:resource="#Persona"/>
</owl:Class>

<owl:Class rdf:about="#Pedido">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#PedidoGrande">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Pedido"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#contienePizza"/>
          <owl:onClass rdf:resource="#Pizza"/>
          <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ClienteVIP">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Cliente"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#realizaPedido"/>
          <owl:someValuesFrom rdf:resource="#PedidoGrande"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ClientePreferente">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Cliente"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#realizaPedido"/>
          <owl:onClass rdf:resource="#Pedido"/>
          <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:NamedIndividual rdf:about="#France">
  <rdf:type rdf:resource="#Country"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Germany">
  <rdf:type rdf:resource="#Country"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Italy">
  <rdf:type rdf:resource="#Country"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#UK">
  <rdf:type rdf:resource="#Country"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#USA">
  <rdf:type rdf:resource="#Country"/>
</owl:NamedIndividual>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Persona"/>
    <rdf:Description rdf:about="#Pedido"/>
    <rdf:Description rdf:about="#Pizza"/>
    <rdf:Description rdf:about="#PizzaBase"/>
    <rdf:Description rdf:about="#PizzaTopping"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Persona"/>
    <rdf:Description rdf:about="#Pedido"/>
    <rdf:Description rdf:about="#Pizza"/>
    <rdf:Description rdf:about="#PizzaBase"/>
    <rdf:Description rdf:about="#PizzaTopping"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#HamTopping"/>
    <rdf:Description rdf:about="#PepperoniTopping"/>
    <rdf:Description rdf:about="#SalamiTopping"/>
    <rdf:Description rdf:about="#SpicyBeefTopping"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#GreenPepperTopping"/>
    <rdf:Description rdf:about="#JalapenoPepperTopping"/>
    <rdf:Description rdf:about="#RedPepperTopping"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#CheeseTopping"/>
    <rdf:Description rdf:about="#MeatTopping"/>
    <rdf:Description rdf:about="#SeafoodTopping"/>
    <rdf:Description rdf:about="#VegetableTopping"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#CaperTopping"/>
    <rdf:Description rdf:about="#MushroomTopping"/>
    <rdf:Description rdf:about="#OliveTopping"/>
    <rdf:Description rdf:about="#OnionTopping"/>
    <rdf:Description rdf:about="#PepperTopping"/>
    <rdf:Description rdf:about="#TomatoTopping"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#AnchovyTopping"/>
    <rdf:Description rdf:about="#PrawnTopping"/>
    <rdf:Description rdf:about="#TunaTopping"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#AmericanHotPizza"/>
    <rdf:Description rdf:about="#AmericanPizza"/>
    <rdf:Description rdf:about="#MargheritaPizza"/>
    <rdf:Description rdf:about="#SohoPizza"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
