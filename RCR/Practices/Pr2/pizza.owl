<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.upv.es/etsinf/rcr/pizza.owl#"
     xml:base="http://www.upv.es/etsinf/rcr/pizza.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#hasBase -->

    <owl:ObjectProperty rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#hasBase">
        <rdfs:subPropertyOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasIngredient"/>
        <owl:inverseOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#isBaseOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#Pizza"/>
        <rdfs:range rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaBase"/>
    </owl:ObjectProperty>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#hasCountryOfOrigin -->

    <owl:ObjectProperty rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#hasCountryOfOrigin">
        <owl:inverseOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#isOriginOf"/>
        <rdfs:domain rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#Pizza"/>
        <rdfs:range rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#Country"/>
    </owl:ObjectProperty>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#hasIngredient -->

    <owl:ObjectProperty rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#hasIngredient">
        <owl:inverseOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#isIngredientOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#Pizza"/>
    </owl:ObjectProperty>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping -->

    <owl:ObjectProperty rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping">
        <rdfs:subPropertyOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasIngredient"/>
        <owl:inverseOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#isToppingOf"/>
        <rdfs:domain rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#Pizza"/>
        <rdfs:range rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaTopping"/>
    </owl:ObjectProperty>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#isBaseOf -->

    <owl:ObjectProperty rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#isBaseOf">
        <rdfs:subPropertyOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#isIngredientOf"/>
        <rdfs:domain rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaBase"/>
        <rdfs:range rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#Pizza"/>
    </owl:ObjectProperty>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#isIngredientOf -->

    <owl:ObjectProperty rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#isIngredientOf">
        <rdfs:range rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#Pizza"/>
    </owl:ObjectProperty>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#isOriginOf -->

    <owl:ObjectProperty rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#isOriginOf">
        <rdfs:domain rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#Country"/>
        <rdfs:range rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#Pizza"/>
    </owl:ObjectProperty>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#isToppingOf -->

    <owl:ObjectProperty rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#isToppingOf">
        <rdfs:subPropertyOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#isIngredientOf"/>
        <rdfs:domain rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaTopping"/>
        <rdfs:range rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#Pizza"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#AmericanHotPizza -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#AmericanHotPizza">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#JalapenoPepperTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PepperoniTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A pizza that only has Mozarrella and Tomato toppings</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#AmericanPizza -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#AmericanPizza">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PepperoniTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A pizza that only has Mozarrella and Tomato toppings</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#AnchovyTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#AnchovyTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#SeafoodTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#CaperTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#CaperTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#VegetableTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#CheeseTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#CheeseTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#CheesyPizza -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#CheesyPizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                        <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#CheeseTopping"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#Country -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#Country"/>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#DeepPanBase -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#DeepPanBase">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaBase"/>
        <owl:disjointWith rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#ThinAndCrispyBase"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#GreenPepperTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#GreenPepperTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PepperTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#HamTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#HamTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#MeatTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#JalapenoPepperTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#JalapenoPepperTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PepperTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#MargheritaPizza -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#MargheritaPizza">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A pizza that only has Mozarrella and Tomato toppings</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#MeatTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#MeatTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#MozzarellaTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#MozzarellaTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#CheeseTopping"/>
        <owl:disjointWith rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#ParmesanTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#MushroomTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#MushroomTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#VegetableTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#NamedPizza -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#NamedPizza">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#Pizza"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#OliveTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#OliveTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#VegetableTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#OnionTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#OnionTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#VegetableTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#ParmesanTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#ParmesanTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#CheeseTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#PepperTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#PepperTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#VegetableTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#PepperoniTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#PepperoniTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#MeatTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#Pizza -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#Pizza">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasBase"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaBase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#PizzaBase -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaBase">
        <owl:disjointWith rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#PizzaTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaTopping"/>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#PrawnTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#PrawnTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#SeafoodTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#RedPepperTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#RedPepperTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PepperTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#SalamiTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#SalamiTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#MeatTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#SeafoodTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#SeafoodTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#SohoPizza -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#SohoPizza">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#OliveTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#ParmesanTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A pizza that only has Mozarrella and Tomato toppings</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#SpicyBeefTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#SpicyBeefTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#MeatTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#ThinAndCrispyBase -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#ThinAndCrispyBase">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaBase"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#TomatoTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#TomatoTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#VegetableTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#TunaTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#TunaTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#SeafoodTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#VegetableTopping -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#VegetableTopping">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#PizzaTopping"/>
    </owl:Class>
    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#VegetarianPizza -->

    <owl:Class rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#VegetarianPizza">
        <rdfs:subClassOf rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#Pizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#hasTopping"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#CheeseTopping"/>
                            <rdf:Description rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#VegetableTopping"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.upv.es/etsinf/rcr/pizza.owl#France -->

    <owl:NamedIndividual rdf:about="http://www.upv.es/etsinf/rcr/pizza.owl#France">
        <rdf:type rdf:resource="http://www.upv.es/etsinf/rcr/pizza.owl#Country"/>
    </owl:NamedIndividual>
    


